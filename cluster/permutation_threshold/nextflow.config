manifest {
    name            = 'gwa-permutation-threshold'
    description     = 'Genome-wide significance by phenotype permutation, GEMMA LOCO'
    nextflowVersion = '>=21.10.0'
}

/* Params live HERE, not in main.nf. nextflow.config is parsed before the
 * script, so a ${params.x} inside a process or profile block can only resolve
 * against params declared in this file -- otherwise Nextflow reads it as a
 * config attribute and fails with
 *   Unknown config attribute `process.withName:...params.x`
 * which is exactly what happened on the first cluster run. And because config
 * is evaluated top-down, this block must precede the process/profiles blocks
 * that interpolate it: a reference above its definition silently yields
 * "[:]/..." rather than an error.
 */
params {
    // Inputs
    vcf   = '/u/project/kruglyak/thatguy0/genomics/vcf/WI.20210121.hard-filter.isotype_with_cM.vcf.gz'
    // required: pass --pheno <traits.csv>. No default, because a stale default
    // silently computes a threshold for the wrong experiment.
    pheno = null
    // comma-separated; one threshold per trait, and they must share a
    // phenotyped-strain set (prep_order.R refuses otherwise -- see its header)
    traits = 'vst_ctrl_pos-1_T2'

    /* THE SCAN'S OWN INPUTS, shipped rather than recomputed.
     *
     * snps: the 464,208 marker ids GEMMA actually received in the 2023 run,
     * taken from its traits_gemmaSnps.tsv. Shipped for two reasons. First, it
     * pins the tested set by construction instead of by luck -- an earlier
     * version guessed the filter chain and tested 519,341 markers. Second, that
     * file is one marker short of what plink retained (464,209), because the
     * scan built it with `awk 'NR!=1'` on a .gen file, which has no header, so
     * the first variant was dropped. Using the file reproduces the scan exactly
     * without reproducing the bug in code.
     *
     * sample_order: the scan's oxford .sample. BIMBAM has no sample ids, so
     * this file is the definition of which dosage column is which strain.
     *
     * The scan's plink log is alongside them for reference. */
    snps         = "${projectDir}/snps/pos1_2023_gemma_snps.tsv.gz"
    sample_order = "${projectDir}/snps/pos1_2023_traits.sample"

    // Hard assertions, at both ends of the pipeline. See the README: the marker
    // count alone passed while the kinship was wrong, and the marker count and
    // the kinship together passed while the missing-genotype encoding was
    // wrong. Only the observed maximum tests the whole chain.
    expect_variants     = 464209   // plink's retained count in the scan's log
    expect_individuals  = 366      // every strain in the phenotype file
    expect_observed_max = 8.8361   // the scan's genome-wide maximum
    observed_tol        = 0.01
    maf = 0.05                     // as the scan; --geno defaults to 0.1

    chromosomes = ['I', 'II', 'III', 'IV', 'V', 'X']

    // permutations, and how many share one SGE job. Wall clock per job scales
    // with perm_batch -- raise h_rt for GEMMA_PERM alongside it.
    n_perm     = 1000
    perm_batch = 25
    seed       = 1
    alpha      = [0.05, 0.10, 0.01]

    // Output -- date-stamped so repeat runs do not overwrite each other
    name   = null
    outdir = "results_perm_${new Date().format('yyyyMMdd')}${params.name ? '_' + params.name : ''}"

    // binaries, same as gemma_nf
    plink     = '/u/project/kruglyak/thatguy0/bin/plink'
    gemma     = '/u/project/kruglyak/thatguy0/bin/gemma'
    conda_bin = '/u/project/kruglyak/thatguy0/conda/bin'
    r_env_bin = '/u/project/kruglyak/thatguy0/conda/envs/gemma_plots/bin'
}

/* Resources.
 *
 * NOTE ON `memory`: it is deliberately NOT set here. Nextflow's SGE executor
 * translates the `memory` directive into its own `-l` request (virtual_free /
 * h_vmem depending on version), which lands ALONGSIDE the h_data in
 * clusterOptions. Hoffman2 schedules on h_data; the extra constraint is not the
 * resource the cluster tracks, so it only narrows the eligible node set and
 * leaves the job sitting in qw. Memory is expressed once, as h_data, in the
 * hoffman2 profile below.
 *
 * h_data is PER SLOT on Hoffman2: a single-slot job asking 8G gets 8G total.
 * Ask for a lot on one slot and you are waiting for a large-memory node, most
 * of which are group-owned. Above ~8G/slot, add slots instead. */
process {
    cpus = 1
    time = '1h'

    withName: 'PLINK_CONVERT'  { time = '4h' }
    withName: 'BUILD_BIMBAM'   { time = '3h' }
    withName: 'GEMMA_GRM'      { time = '4h' }
    /* One job runs perm_batch GEMMA calls IN SERIES, and each call re-parses
     * the whole-genome BIMBAM (464,209 markers x 366 individuals) even though
     * -loco tests only one chromosome, so the parse dominates and wall clock
     * scales almost linearly with perm_batch. At perm_batch 10 this fits in 8h;
     * at 25 it does not, and SGE kills the job with no exit status and no
     * output ("terminated by the external system"), which is easy to misread as
     * a crash. 24h with retries instead. */
    withName: 'GEMMA_PERM'     { time = '24h' }
    withName: 'MAKE_PERMS'     { time = '1h' }
    withName: 'COLLECT_THRESHOLD' { time = '1h' }
}

profiles {
    standard {
        process.executor = 'local'
    }

    hoffman2 {
        workDir = '/u/project/kruglyak/thatguy0/scratch/'

        process {
            executor       = 'sge'
            penv           = 'shared'
            clusterOptions = '-V -l h_rt=4:00:00'

            /* 8G, not the 36G/24G these carried from gemma_nf. That number was
             * inherited, not measured: after --extract this holds 464,045
             * markers x 231 strains, which is ~27 MB of packed genotypes, and
             * the largest real allocation is plink's variant-id hash over the
             * whole VCF (~100 MB). The script now passes --memory explicitly so
             * plink cannot claim half the node and get killed for exceeding
             * h_data, which is the failure the oversized request was hiding. */
            withName: 'PLINK_CONVERT' { clusterOptions = '-V -l h_data=8G,h_rt=4:00:00' }
            withName: 'BUILD_BIMBAM'  { clusterOptions = '-V -l h_data=8G,h_rt=3:00:00' }
            withName: 'GEMMA_GRM'     { clusterOptions = '-V -l h_data=8G,h_rt=4:00:00'  }
            withName: 'GEMMA_PERM'    {
                clusterOptions = '-V -l h_data=8G,h_rt=24:00:00'
                /* A wall-clock kill is worth retrying, because the retry is
                 * cheap next to re-running the whole scan by hand and the
                 * failure is not deterministic -- a slow node can push a job
                 * over where the same job elsewhere fits. Nextflow reruns only
                 * the failed task, so a retry costs one batch, not the run.
                 * maxErrors caps a systematic problem from retrying 240 times. */
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
                maxRetries    = 2
                maxErrors     = 10
            }

            /* INVARIANT, carried over from gemma_nf and for the same reason:
             * every process whose script calls an R script must appear in this
             * selector. One missing falls through to the system R and dies on a
             * dplyr/ABI clash. The conda R build ships its own libstdc++, so
             * R_HOME and LD_LIBRARY_PATH are cleared (-V exports the submitting
             * shell's env, which may carry module-loaded library paths that
             * shadow the conda env's matched libraries whatever PATH says), and
             * R_LIBS_USER is aimed at a nonexistent path so no mismatched-ABI
             * packages from ~/R are picked up. */
            withName: 'PREP_ORDER|MAKE_PERMS|COLLECT_THRESHOLD' {
                clusterOptions = '-V -l h_data=8G,h_rt=1:00:00'
                beforeScript = "unset R_HOME; unset LD_LIBRARY_PATH; export R_LIBS_USER=/nonexistent; export R_LIBS=; export PATH=\"${params.r_env_bin}:${params.conda_bin}:\$PATH\""
            }
        }
        executor {
            queueSize = 50
        }
    }
}
