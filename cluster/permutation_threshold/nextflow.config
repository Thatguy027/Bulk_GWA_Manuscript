manifest {
    name            = 'gwa-permutation-threshold'
    description     = 'Genome-wide significance by phenotype permutation, GEMMA LOCO'
    nextflowVersion = '>=21.10.0'
}

/* Resource shapes follow the gemma_nf pipeline this sits beside: h_data is
 * PER SLOT on Hoffman2, so a single-slot job asking 8G gets 8G total. */
process {
    cpus   = 1
    memory = '4 GB'
    time   = '1h'

    withName: 'PLINK_CONVERT'  { cpus = 1; memory = '36 GB'; time = '4h' }
    withName: 'BUILD_CHROM'    { memory = '24 GB'; time = '3h' }
    withName: 'GEMMA_GRM'      { memory = '8 GB';  time = '4h' }
    // one job runs perm_batch GEMMA calls in series, so its wall clock scales
    // with the batch size -- raise h_rt if perm_batch is increased
    withName: 'GEMMA_PERM'     { memory = '8 GB';  time = '8h' }
    withName: 'MAKE_PERMS'     { memory = '4 GB';  time = '1h' }
    withName: 'COLLECT_THRESHOLD' { memory = '8 GB'; time = '1h' }
}

profiles {
    standard {
        process.executor = 'local'
    }

    hoffman2 {
        workDir = '/u/project/kruglyak/thatguy0/scratch/'

        process {
            executor       = 'sge'
            penv           = 'shared'
            clusterOptions = '-V -l h_rt=4:00:00'

            withName: 'PLINK_CONVERT' { clusterOptions = '-V -l h_data=36G,h_rt=4:00:00' }
            withName: 'BUILD_CHROM'   { clusterOptions = '-V -l h_data=24G,h_rt=3:00:00' }
            withName: 'GEMMA_GRM'     { clusterOptions = '-V -l h_data=8G,h_rt=4:00:00'  }
            withName: 'GEMMA_PERM'    { clusterOptions = '-V -l h_data=8G,h_rt=8:00:00'  }

            /* INVARIANT, carried over from gemma_nf and for the same reason:
             * every process whose script calls an R script must appear in this
             * selector. One missing falls through to the system R and dies on a
             * dplyr/ABI clash. The conda R build ships its own libstdc++, so
             * R_HOME and LD_LIBRARY_PATH are cleared (-V exports the submitting
             * shell's env, which may carry module-loaded library paths that
             * shadow the conda env's matched libraries whatever PATH says), and
             * R_LIBS_USER is aimed at a nonexistent path so no mismatched-ABI
             * packages from ~/R are picked up. */
            withName: 'MAKE_PERMS|COLLECT_THRESHOLD' {
                clusterOptions = '-V -l h_data=8G,h_rt=1:00:00'
                beforeScript = "unset R_HOME; unset LD_LIBRARY_PATH; export R_LIBS_USER=/nonexistent; export R_LIBS=; export PATH=\"${params.r_env_bin}:${params.conda_bin}:\$PATH\""
            }
        }
        executor {
            queueSize = 50
        }
    }
}
