# =============================================================================
# .gitignore
#
# Policy: code, figures and the SMALL inputs a figure script reads stay in git.
# Raw sequence, genotype panels, alignment intermediates, large R objects and
# regenerable caches are archived externally -- see DATA_AVAILABILITY.md for
# what lives where and which script needs which archive.
#
# The working tree is ~12 GB; what remains tracked after this file is ~75 MB.
#
# Note on the pattern style: git cannot re-admit a file inside an ignored
# DIRECTORY, so anywhere an exception is needed the directory's CONTENTS are
# ignored ("dir/*") and the wanted paths are re-admitted with "!". That is why
# some rules below are more verbose than they look like they need to be.
# =============================================================================

# --- OS and editor noise -----------------------------------------------------
.DS_Store
**/.DS_Store
.Rhistory
.Rapp.history
.RData
.Ruserdata
*~
*.swp
__pycache__/
*.pyc

# --- Keynote source for the assembled display ------------------------------
# A .key is a binary bundle that is rewritten in full on every save, so keeping
# it would grow history fast. The exported PDF is tracked instead. If you would
# rather version the editable file, delete this rule.
*.key

# --- stray outputs -----------------------------------------------------------
Rplots.pdf
scripts/Rplots.pdf
*_JuHighlight.pdf

# =============================================================================
# Whole directories no current script reads. All archived.
# =============================================================================

# 6.6 GB. CeNDR PLINK panel and the processed genotype matrix. Rebuildable from
# the CeNDR release; scripts that need it say so.
data/genotypes/

# 53 MB. LD matrices, not read by any script in scripts/.
data/LD/

# 550 MB. Output of an earlier GEMMA run on the 2023 pos-1 panel. The exported
# association table the figures read is kept in updated_analysis/.
data/pos1_original/gemma_output/

# figure output written by analyses that live outside this repository
data/pooled_RNAi_expt/plot/
data/**/*_manplot.png

# 140 MB. Per-chromosome GEMMA output from an earlier run. Not read by any
# script; the exported association tables are what the figures use.
data/pos1_rnai_sensitive/gemma/

# 180 MB. The superseded JU cross analysis, including three 42 MB uncompressed
# contrast tables. Replaced by data/cross_experiments/JU1793-JU2466_export/ and
# referenced only by scripts/legacy/.
data/cross_experiments/Nov2024_JU_cross_pos_mig/

# 281 MB. Cache built by scripts/pooled_cross_intersection_prep.R. Regenerable,
# and the prep script is the documented way to get it back.
data/pooled_cross_intersection/

# =============================================================================
# data/structure_modeling -- 1.9 GB of exploratory modelling. One file from it
# is used by the figures: the membrane-oriented ectodomain.
# =============================================================================
data/structure_modeling/*
!data/structure_modeling/claude_docking/
data/structure_modeling/claude_docking/*
!data/structure_modeling/claude_docking/stage4_electrostatics/
data/structure_modeling/claude_docking/stage4_electrostatics/*
!data/structure_modeling/claude_docking/stage4_electrostatics/sid2_wt_elec.pdb
!data/structure_modeling/claude_docking/stage*/**/*report*.txt

# =============================================================================
# data/cross_experiments -- 1.5 GB of exports. Keep the one contrast scan
# Figure 3 reads, plus the READMEs and sample sheets that document them.
# =============================================================================
data/cross_experiments/*
!data/cross_experiments/*/
data/cross_experiments/*/*
!data/cross_experiments/*/README.md
!data/cross_experiments/*/sample_sheet.tsv
!data/cross_experiments/*/MANIFEST.tsv
!data/cross_experiments/*/intervals/
!data/cross_experiments/JU1793-JU2466_export/plot_data/
data/cross_experiments/JU1793-JU2466_export/plot_data/*
!data/cross_experiments/JU1793-JU2466_export/plot_data/*HT115g-POS1g*_plot_DF.tsv.gz

# =============================================================================
# data/structure -- keep the model and its confidence files, drop the 20 MB of
# CIFs, MSAs and templates.
# =============================================================================
data/structure/AF_sid2_wt_dimer/*
!data/structure/AF_sid2_wt_dimer/sid2wt.pdb
!data/structure/AF_sid2_wt_dimer/*summary_confidences_*.json
data/structure/*.zip

# =============================================================================
# Large formats, wherever they appear under data/
# =============================================================================

# alignment and variant files
data/**/*.bam
data/**/*.bai
data/**/*.cram
data/**/*.crai
data/**/*.vcf
data/**/*.vcf.gz
data/**/*.vcf.gz.tbi
data/**/*.bcf

# PLINK binary sets
data/**/*.bed
data/**/*.bim
data/**/*.fam
data/**/*.pgen
data/**/*.pvar
data/**/*.psam
!data/nil_ranges.bed

# GEMMA/PLINK working inputs. data/pooled_RNAi_expt/reanalysis/mapping/plink/
# holds a 188 MB traits.gen; only the exported *_loco_results.csv.gz in that
# directory are needed by the figures.
data/**/plink/
data/**/*.gen
data/**/*.gen.gz
data/**/*.sample

# GATK ASEReadCounter tables and MSAs
data/**/*.table.gz
data/**/*.a3m

# R binary objects are large by default. The few small ones the figures read
# are re-admitted here; keep this list in step with the scripts.
data/**/*.Rdata
data/**/*.RData
data/**/*.rda
data/**/*.Rda
data/**/*.rds
!data/baugh/2024_processedBOOTs_with_MIP.RData
!data/baugh/2024baugh_bootstrap_prediction.rda
!data/baugh/2026downsampled_dataset.rda
!data/pos1_rnai_sensitive/processed_strain_fq.rda
!data/pos1_original/2024pub_prediction_bootstrap_combined_df.Rdata

# caches written by the Figure 1 scripts; rebuilt with FIG1_REFRESH=1
data/baugh/cache_*.rds

# archives
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz

# =============================================================================
# plots -- keep the figures, drop the exploratory set and the regenerable
# render assets. The variant tables under pooled_cross_intersection ARE read by
# scripts/sid2_variant_table.R, so they stay.
# =============================================================================
# superseded figures, 13 MB. The scripts that made them are in scripts/legacy/
# and the versions that matter are in git history.
plots/legacy/

plots/pooled_cross_intersection/*
!plots/pooled_cross_intersection/TABLE_*.tsv
!plots/pooled_cross_intersection/TABLE_*.tsv.gz
!plots/pooled_cross_intersection/variants_by_qtl/
# plots/assets is KEPT (4.6 MB): the R figure scripts read these renders, so
# keeping them means Figure 4 builds from a fresh clone without running the
# Python renderers first. Regenerate with sid2_ribbon_render.py and
# sid2_zoom_render.py if the structure changes.

# =============================================================================
# scratch
# =============================================================================
scratch/
tmp/
regenerated/
cache/
